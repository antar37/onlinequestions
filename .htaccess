# Online Questions - Apache Configuration

# Enable URL rewriting for clean room URLs
RewriteEngine On

# Security: Prevent directory listing
Options -Indexes

# Prevent access to rooms and events directories
RewriteRule ^rooms/.*$ - [F,L]
RewriteRule ^events/.*$ - [F,L]

# Prevent access to JSON files in rooms directory (extra protection)
RewriteRule ^rooms/.*\.json$ - [F,L]

# Redirect /room/ROOMID to index.php?room=ROOMID
# Allow alphanumeric and hyphens, 3-50 characters
RewriteRule ^room/([a-zA-Z0-9-]{3,50})/?$ index.php?room=$1 [L,QSA]

# Set default charset
AddDefaultCharset UTF-8

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
</IfModule>
